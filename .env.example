# ==============================================================================
# DarKitOS Environment Configuration
# ==============================================================================

# --- Core Auth & Demo Mode ---
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-32-byte-random-secret-for-production

# Enable instant Owner demo workspace without manual login (set to "false" in production)
DEMO_SANDBOX_MODE=true

# --- Sprint 1 (Supabase Mumbai ap-south-1 + Drizzle ORM) ---
# Runtime app connection: Supabase Supavisor Transaction Pooler (port 6543, prepare: false)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Schema migrations & seed connection: Supabase Direct / Session connection (port 5432)
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional dedicated test database URL for Vitest PostgreSQL integration tests
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/darkitos_test

# --- Sprint 2 (Supabase Auth & Sub-Second Realtime KDS) ---
# Public browser-safe Supabase project URL & publishable/anon key
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# STRICTLY SERVER-ONLY — never prefix with NEXT_PUBLIC_ or expose to client bundles
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Sprint 3A (Razorpay Direct Web Payments & Indian GST) ---
# Leave unset in local dev / demo sandbox for deterministic offline Razorpay sandbox fallback
RAZORPAY_KEY_ID=
# STRICTLY SERVER-ONLY — never prefix with NEXT_PUBLIC_ or expose to client bundles
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Sprint 3B (UrbanPiper, Upstash QStash & WhatsApp) ---
# URBANPIPER_API_KEY=
# URBANPIPER_WEBHOOK_SECRET=
# QSTASH_TOKEN=
# WHATSAPP_PROVIDER_API_KEY=

# --- Sprint 4 (Live Gemini API Operational Copilot) ---
# GEMINI_API_KEY=
